{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicWebsite",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-website/*"
    },
    {
      "Sid": "EnforceTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::my-website", "arn:aws:s3:::my-website/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
